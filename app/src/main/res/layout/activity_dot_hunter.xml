<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dothunter_background"
    tools:context=".DotHunter.DotHunterActivity">

    <LinearLayout
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:background="@color/red"
            android:gravity="end"
            android:paddingVertical="16dp"
            android:text="D"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/red"
            app:cardElevation="0dp">

            <androidx.cardview.widget.CardView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/black"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:background="@color/red"
            android:gravity="start"
            android:paddingVertical="16dp"
            android:text="t Hunter"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvMessage1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp"
        android:text="@string/initial_message1"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tvMessage2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <TextView
        android:id="@+id/tvMessage2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp"
        android:text="@string/initial_message2"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/cvBoard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMessage1" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cvBoard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMessage2">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/btnUp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/dot_hunter_btnup"
                android:src="@drawable/up_arrow"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/black" />

            <ImageView
                android:id="@+id/btnDown"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/dot_hunter_btndown"
                android:src="@drawable/down_arrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:tint="@color/black" />

            <ImageView
                android:id="@+id/btnLeft"
                android:layout_width="48dp"
                android:layout_height="0dp"
                android:background="#FF5722"
                android:src="@drawable/left_arrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnUp"
                app:layout_constraintBottom_toTopOf="@id/btnDown"
                app:tint="@color/black" />

            <ImageView
                android:id="@+id/btnRight"
                android:layout_width="48dp"
                android:layout_height="0dp"
                android:background="#4CAF50"
                android:src="@drawable/right_arrow"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnUp"
                app:layout_constraintBottom_toTopOf="@id/btnDown"
                app:tint="@color/black" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="24dp"
                android:background="@color/dot_hunter_board"
                android:gravity="center"
                app:layout_constraintStart_toEndOf="@id/btnLeft"
                app:layout_constraintEnd_toStartOf="@id/btnRight"
                app:layout_constraintTop_toBottomOf="@id/btnUp"
                app:layout_constraintBottom_toTopOf="@id/btnDown">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/out00"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/dothunter_background"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/in00"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            android:layout_gravity="center"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/out01"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/dot_hunter_tiles"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/in01"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="@color/dot_hunter_tiles"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            android:layout_gravity="center"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/out02"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/dot_hunter_tiles"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/in02"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="@color/dot_hunter_tiles"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            android:layout_gravity="center"/>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/out10"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/dot_hunter_tiles"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/in10"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="@color/dot_hunter_tiles"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            android:layout_gravity="center"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/out11"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/dot_hunter_tiles"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/in11"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="@color/dot_hunter_tiles"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            android:layout_gravity="center"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/out12"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/dot_hunter_tiles"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/in12"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="@color/dot_hunter_tiles"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            android:layout_gravity="center"/>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/out20"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/dot_hunter_tiles"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/in20"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="@color/dot_hunter_tiles"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            android:layout_gravity="center"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/out21"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/dot_hunter_tiles"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/in21"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="@color/dot_hunter_tiles"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            android:layout_gravity="center"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/out22"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/dot_hunter_tiles"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/in22"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="@color/dot_hunter_tiles"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            android:layout_gravity="center"/>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/out30"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/dot_hunter_tiles"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/in30"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="@color/dot_hunter_tiles"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            android:layout_gravity="center"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/out31"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/dot_hunter_tiles"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/in31"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="@color/dot_hunter_tiles"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            android:layout_gravity="center"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/out32"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/dot_hunter_tiles"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/in32"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="@color/dot_hunter_tiles"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            android:layout_gravity="center"/>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/out40"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/dot_hunter_tiles"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/in40"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="@color/dot_hunter_tiles"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            android:layout_gravity="center"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/out41"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/dot_hunter_tiles"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/in41"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="@color/dot_hunter_tiles"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            android:layout_gravity="center"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/out42"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/dot_hunter_tiles"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/in42"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="@color/dot_hunter_tiles"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            android:layout_gravity="center"/>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>