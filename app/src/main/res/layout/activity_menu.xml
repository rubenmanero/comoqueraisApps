<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MenuActivity">

    <ImageView
        android:id="@+id/ivMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/wallpaper_android"
        android:scaleType="centerCrop"/>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <Button
            android:id="@+id/btnHelloApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Hello App"
            android:textSize="25sp"
            android:textColor="@color/black"
            android:fontFamily="serif-monospace"
            android:textStyle="bold"
            android:backgroundTint="#1E7C1E"/>

        <Button
            android:id="@+id/btnMessageApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Message App"
            android:textSize="25sp"
            android:textColor="@color/black"
            android:fontFamily="serif-monospace"
            android:textStyle="bold"
            android:backgroundTint="#1E7C1E" />

        <Button
            android:id="@+id/btnIMCApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="IMC App"
            android:textSize="25sp"
            android:textColor="@color/black"
            android:fontFamily="serif-monospace"
            android:textStyle="bold"
            android:backgroundTint="#1E7C1E" />

        <Button
            android:id="@+id/btnBoardgamesApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Boardgames App"
            android:textSize="25sp"
            android:textColor="@color/black"
            android:fontFamily="serif-monospace"
            android:textStyle="bold"
            android:backgroundTint="#1E7C1E" />

        <Button
            android:id="@+id/btnSuperheroApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Superhero App"
            android:textSize="25sp"
            android:textColor="@color/black"
            android:fontFamily="serif-monospace"
            android:textStyle="bold"
            android:backgroundTint="#1E7C1E" />

        <Button
            android:id="@+id/btnRepaso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Repaso"
            android:textSize="25sp"
            android:textColor="@color/black"
            android:fontFamily="serif-monospace"
            android:textStyle="bold"
            android:backgroundTint="#1E7C1E" />

        <Button
            android:id="@+id/btnDotHunter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="DotHunter"
            android:textSize="25sp"
            android:textColor="@color/black"
            android:fontFamily="serif-monospace"
            android:textStyle="bold"
            android:backgroundTint="#1E7C1E" />

        <Button
            android:id="@+id/btnCalcutreladora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Calcutreladora"
            android:textSize="25sp"
            android:textColor="@color/black"
            android:fontFamily="serif-monospace"
            android:textStyle="bold"
            android:backgroundTint="#1E7C1E" />

        <Button
            android:id="@+id/btnMemory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Memory"
            android:textSize="25sp"
            android:textColor="@color/black"
            android:fontFamily="serif-monospace"
            android:textStyle="bold"
            android:backgroundTint="#1E7C1E" />

        <Button
            android:id="@+id/btnTicTacToe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Tic Tac Toe"
            android:textSize="25sp"
            android:textColor="@color/black"
            android:fontFamily="serif-monospace"
            android:textStyle="bold"
            android:backgroundTint="#1E7C1E" />

    </LinearLayout>
</FrameLayout>