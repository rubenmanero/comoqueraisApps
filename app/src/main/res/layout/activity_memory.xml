<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Memory.MemoryActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:text="Memory"
        android:background="@color/memory_background"
        android:textColor="@color/memory_text"
        android:textSize="48sp"
        android:gravity="center"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Prueba"
        android:textColor="@color/black"
        android:textSize="36sp"
        android:gravity="center"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toTopOf="@id/board"/>

    <LinearLayout
        android:id="@+id/board"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="140dp"
                android:layout_margin="2dp"
                app:cardCornerRadius="16dp">

                <ImageView
                    android:id="@+id/iv00"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/memory_card1"
                    android:padding="20dp"
                    android:src="@drawable/ic_substract"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="140dp"
                android:layout_margin="2dp"
                app:cardCornerRadius="16dp">

                <ImageView
                    android:id="@+id/iv01"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/memory_card2"
                    android:padding="20dp"
                    app:tint="@color/white"
                    android:src="@drawable/ic_add"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="140dp"
                android:layout_margin="2dp"
                app:cardCornerRadius="16dp">

                <ImageView
                    android:id="@+id/iv02"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FF5151"
                    android:padding="10dp"
                    android:src="@drawable/ic_female"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="140dp"
                android:layout_margin="2dp"
                app:cardCornerRadius="16dp">

                <ImageView
                    android:id="@+id/iv10"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/memory_card4"
                    app:tint="@color/black"
                    android:src="@drawable/ic_launcher_foreground"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="140dp"
                android:layout_margin="2dp"
                app:cardCornerRadius="16dp">

                <ImageView
                    android:id="@+id/iv11"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/memory_card3"
                    android:padding="10dp"
                    android:src="@drawable/ic_female"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="140dp"
                android:layout_margin="2dp"
                app:cardCornerRadius="16dp">

                <ImageView
                    android:id="@+id/iv12"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/memory_card5"
                    android:padding="5dp"
                    android:src="@drawable/rounded_arrow"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="140dp"
                android:layout_margin="2dp"
                app:cardCornerRadius="16dp">

                <ImageView
                    android:id="@+id/iv20"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/memory_card6"
                    android:padding="20dp"
                    app:tint="@color/white"
                    android:src="@drawable/ic_male"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="140dp"
                android:layout_margin="2dp"
                app:cardCornerRadius="16dp">

                <ImageView
                    android:id="@+id/iv21"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/memory_card1"
                    android:padding="20dp"
                    android:src="@drawable/ic_substract"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="140dp"
                android:layout_margin="2dp"
                app:cardCornerRadius="16dp">

                <ImageView
                    android:id="@+id/iv22"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/memory_card4"
                    app:tint="@color/black"
                    android:src="@drawable/ic_launcher_foreground"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="140dp"
                android:layout_margin="2dp"
                app:cardCornerRadius="16dp">

                <ImageView
                    android:id="@+id/iv30"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/memory_card6"
                    android:padding="20dp"
                    app:tint="@color/white"
                    android:src="@drawable/ic_male"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="140dp"
                android:layout_margin="2dp"
                app:cardCornerRadius="16dp">

                <ImageView
                    android:id="@+id/iv31"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/memory_card5"
                    android:padding="5dp"
                    android:src="@drawable/rounded_arrow"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="140dp"
                android:layout_margin="2dp"
                app:cardCornerRadius="16dp">

                <ImageView
                    android:id="@+id/iv32"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/memory_card2"
                    android:padding="20dp"
                    app:tint="@color/white"
                    android:src="@drawable/ic_add"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>